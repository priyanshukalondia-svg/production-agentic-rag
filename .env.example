# Safe defaults for the offline deterministic backend.
RAG_LLM_PROVIDER=mock
RAG_EMBED_PROVIDER=hashing
RAG_LLM_MODEL=gpt-4o-mini
RAG_EMBED_MODEL=text-embedding-3-small

RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_CHUNK_SIZE=120
RAG_CHUNK_OVERLAP=24
RAG_RERANK=1

RAG_MAX_ITERS=2
RAG_ENGINE=agent
RAG_FAITHFULNESS=0.6